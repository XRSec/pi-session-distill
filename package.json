{
  "name": "pi-session-distill",
  "version": "4.5.5",
  "private": false,
  "type": "module",
  "description": "Agent State Handoff cleanup, merge, verification, and repeatable re-cleaning for Pi sessions",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "compaction",
    "handoff",
    "distill",
    "merge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XRSec/pi-session-distill.git"
  },
  "scripts": {
    "analyze": "node --experimental-strip-types scripts/analyze-session.ts",
    "smoke:cleanup": "node scripts/pi-web-cleanup-smoke.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "files": [
    "index.ts",
    "checkpoint.ts",
    "core.ts",
    "handoff.ts",
    "history.ts",
    "native-compaction.ts",
    "session-writer.ts",
    "settings.ts",
    "textual.ts",
    "standalone.ts",
    "schemas",
    "types",
    "scripts",
    "tests",
    "README.md",
    "REQUIREMENTS.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
